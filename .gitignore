# Dependencies
node_modules/
vendor/
.venv/
venv/
__pycache__/
*.py[cod]
.pnp/
.pnp.js

# Env & secrets
.env
.env.*
!.env.example
*.pem
*.key
!**/testing/*.key

# Build output
.next/
out/
dist/
build/
# Laravel runtime state. These live under backend/, and a pattern containing a
# slash is anchored to this file's directory — so they must be written out in
# full or they silently match nothing. The directories themselves are tracked
# via .gitkeep, because Laravel will not create them and fails to boot without.
backend/storage/framework/cache/*
!backend/storage/framework/cache/data/
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/framework/testing/*
backend/storage/app/public/*
backend/storage/logs/*
!**/.gitkeep
backend/public/hot
backend/public/storage
backend/bootstrap/cache/*.php

# Flutter
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/ios/Pods/
mobile/android/.gradle/
*.iml

# AI artefacts
ai-service/models/*.pkl
ai-service/models/*.json
ai-service/models/*.joblib
!ai-service/models/.gitkeep

# Tooling
.DS_Store
.idea/
.vscode/
coverage/
.phpunit.result.cache
backend/.phpunit.cache/
.pytest_cache/
*.log

# Next.js build metadata
frontend/.next/
frontend/next-env.d.ts
# Incremental typecheck cache — regenerated by `tsc`, never reviewed.
frontend/tsconfig.tsbuildinfo
