APP_NAME="Fuel Intelligence Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fip
DB_USERNAME=fip
DB_PASSWORD=

# Optional read replica. Leave unset for a single-node database: SELECTs then
# fall back to DB_HOST. Setting it to an unreachable host breaks every read.
# DB_READ_PORT defaults to DB_PORT; set it when the replica is reached through
# a proxy or tunnel on another port.
# DB_READ_HOST=
# DB_READ_PORT=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=false

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# JWT — generate with `php artisan jwt:secret`
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=fip-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_MAPS_API_KEY=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/apple/callback

FCM_SERVER_KEY=
FCM_PROJECT_ID=

DOE_FEED_URL=https://www.doe.gov.ph/retail-pump-prices
EXCHANGE_RATE_API_KEY=

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@fip.ph
MAIL_FROM_NAME="Fuel Intelligence Platform"

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Domain tuning — see config/fip.php for the full list
FIP_CROWD_AUTO_APPROVE_TRUST=0.80
FIP_MAX_PRICE_DEVIATION=0.15
FIP_FRAUD_SCORE_THRESHOLD=0.65
FIP_MIN_FORECAST_CONFIDENCE=0.60

# Vehicle location tracking (Phase 3). Foreground-only; see docs/07-security.md
# §7.4 and docs/12-privacy-impact-assessment.md.
#
# ⚠️ RETENTION IS A DECISION, NOT A DEFAULT. 30 is a provisional placeholder
# pending business and privacy approval. Set it deliberately before this runs on
# real drivers. 0 disables pruning entirely — history then accumulates forever,
# which is the one value no deployment should reach by accident.
FIP_LOCATION_RETENTION_DAYS=30

# Collection shape. Longer intervals and larger distances cost battery and rows
# in inverse proportion; these defaults are roughly 30 points per driving hour.
FIP_LOCATION_SAMPLING_SECONDS=120
FIP_LOCATION_MIN_DISTANCE_M=50

# Ingestion limits. A fix worse than max accuracy is discarded rather than shown
# as a confident pin in the wrong suburb.
FIP_LOCATION_MAX_ACCURACY_M=1000
FIP_LOCATION_MAX_SKEW_MINUTES=5
FIP_LOCATION_MAX_BATCH=200

# Read limits for the history endpoint.
FIP_LOCATION_MAX_HISTORY_DAYS=31
FIP_LOCATION_MAX_HISTORY_ROWS=5000

# Rate limit for location ingestion, "requests,minutes". A device flushing a
# queue after an outage sends batches, not single points, so this is per device
# rather than per position.
FIP_RL_LOCATION=60,1
