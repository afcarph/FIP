includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - database/seeders
        - routes

    # Every suppression below is pinned to the files that actually need it, so a
    # new occurrence anywhere else still fails the build -- a mistyped model
    # attribute in a file not listed here is a real error, not a known limit of
    # the analyser. reportUnmatchedIgnoredErrors (on by default) keeps the lists
    # honest: fix one and PHPStan reports the ignore as unmatched.
    ignoreErrors:
        # PHPStan 2 replaced checkMissingIterableValueType and
        # checkGenericClassInNonGenericObjectType with these identifiers. Array
        # shapes are documented where they carry meaning, not on every signature.
        - identifier: missingType.iterableValue
        - identifier: missingType.generics

        # Aggregate aliases: selectRaw('SUM(litres) AS total_litres') hydrates a
        # model with columns that exist only for that one query.
        -
            identifier: property.notFound
            paths:
                - app/Domain/Ai/Services/FuelAdvisorService.php
                - app/Domain/Expense/Services/FuelExpenseService.php
                - app/Domain/Expense/Services/RouteOptimizationService.php
                - app/Domain/Maintenance/Services/MaintenanceService.php
                - app/Domain/Pricing/Models/StationPrice.php
                - app/Domain/Reporting/Services/DashboardService.php
                - app/Domain/Reporting/Services/ReportService.php
                - app/Domain/User/Models/User.php
                - app/Domain/User/Repositories/UserRepository.php
                - app/Domain/Vehicle/Repositories/VehicleRepository.php
                - app/Http/Controllers/Api/V1/PriceController.php
                - app/Http/Controllers/Api/V1/StationController.php
                - app/Http/Controllers/Api/V1/VehicleController.php
                - app/Http/Resources/DeviceLocationResource.php
                - app/Http/Resources/DeviceResource.php
                - app/Http/Resources/DriverResource.php
                - app/Http/Resources/ForecastResource.php
                - app/Http/Resources/FuelPurchaseResource.php
                - app/Http/Resources/FuelReadingResource.php
                - app/Http/Resources/OcrScanResource.php
                - app/Http/Resources/PriceReportResource.php
                - app/Http/Resources/StationResource.php
                - app/Http/Resources/UserResource.php
                - app/Http/Resources/VehicleResource.php

        # Model scopes reached through a relation, which Larastan cannot follow
        # onto the related model.
        -
            identifier: method.notFound
            paths:
                - app/Domain/Expense/Services/FuelExpenseService.php
                - app/Domain/Notification/Services/NotificationService.php
                - app/Domain/Reporting/Services/DashboardService.php
                - app/Domain/Station/Models/City.php
                - app/Domain/Station/Models/GasStation.php
                - app/Http/Controllers/Api/V1/Auth/AuthController.php
                - app/Http/Controllers/Api/V1/FleetController.php
                - app/Http/Controllers/Api/V1/NotificationController.php
                - app/Http/Resources/DeviceResource.php
                - app/Http/Resources/ForecastResource.php
                - app/Http/Resources/PriceReportResource.php
                - app/Http/Resources/VehicleResource.php
                - app/Support/Concerns/Auditable.php

        # Defensive ?-> where the annotations describe a persisted row. The related
        # row is absent until eager-loaded, so the check is real at runtime.
        -
            identifier: nullsafe.neverNull
            paths:
                - app/Console/Commands/GenerateWeeklyForecast.php
                - app/Domain/Ai/Services/FuelAdvisorService.php
                - app/Domain/Expense/Services/RouteOptimizationService.php
                - app/Domain/Fleet/Services/DeviceRegistrationService.php
                - app/Domain/Maintenance/Services/MaintenanceService.php
                - app/Domain/Pricing/Services/PriceService.php
                - app/Domain/Reporting/Services/DashboardService.php
                - app/Domain/Reporting/Services/ReportService.php
                - app/Domain/User/Models/LoginAttempt.php
                - app/Domain/User/Services/AuthService.php
                - app/Domain/Vehicle/Models/Vehicle.php
                - app/Http/Controllers/Api/V1/MaintenanceController.php
                - app/Http/Controllers/Api/V1/ReportController.php
                - app/Http/Resources/StationResource.php
                - app/Jobs/EvaluatePriceAlerts.php
                - app/Jobs/GenerateReport.php
                - app/Jobs/SendMaintenanceReminders.php
                - app/Services/External/AiServiceClient.php
                - app/Support/Concerns/Auditable.php
                - app/Support/Http/ApiResponse.php
                - database/seeders/DemoDataSeeder.php
                - database/seeders/RolePermissionSeeder.php

        # Null guards on NOT NULL columns. The annotations describe persisted rows;
        # an accessor can still run on an unsaved model, so the guard stays.
        -
            identifier: identical.alwaysFalse
            paths:
                - app/Domain/Pricing/Models/OcrScan.php
                - app/Domain/Station/Models/StationPhoto.php

        # As above, on seed definitions where every row happens to share a value.
        -
            identifier: notIdentical.alwaysFalse
            paths:
                - database/seeders/DemoDataSeeder.php

        # Laravel's collection and builder generics are not expressive enough for
        # PHPStan to infer through collect(), when() or remember().
        -
            identifier: argument.templateType
            paths:
                - app/Domain/Pricing/Services/PriceService.php
                - app/Domain/Reporting/Services/ReportService.php
                - app/Http/Controllers/Api/V1/Admin/UserAdminController.php
                - app/Http/Controllers/Api/V1/NotificationController.php
                - app/Http/Controllers/Api/V1/ReportController.php
                - app/Http/Resources/OcrScanResource.php

        # Collection::map() returning an array shape.
        -
            identifier: argument.unresolvableType
            paths:
                - app/Domain/Ai/Services/FuelAdvisorService.php
                - app/Domain/Expense/Services/FuelExpenseService.php
                - app/Domain/Reporting/Services/DashboardService.php
                - app/Domain/User/Repositories/UserRepository.php
                - app/Http/Controllers/Api/V1/StationController.php

        # Collection::map() / all() returning an array shape.
        -
            identifier: method.unresolvableReturnType
            paths:
                - app/Domain/Ai/Services/FuelAdvisorService.php
                - app/Domain/Expense/Services/FuelExpenseService.php
                - app/Domain/Reporting/Services/DashboardService.php
                - app/Domain/User/Repositories/UserRepository.php
                - app/Http/Controllers/Api/V1/StationController.php

