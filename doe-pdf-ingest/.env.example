# Copy to .env and fill in. Every value is read with the DOE_ prefix.
#
# .env is git-ignored. Nothing here should ever be committed with real values.

# --- database ---------------------------------------------------------------
# The platform's own database. The ingest writes fuel_reports, fuel_prices and
# doe_import_runs — tables Laravel creates — and nothing else.
DOE_DB_HOST=127.0.0.1
DOE_DB_PORT=3306
DOE_DB_NAME=fip
DOE_DB_USER=fip
DOE_DB_PASSWORD=

# --- source -----------------------------------------------------------------
# Liferay's GraphQL API is the discovery source. Unauthenticated.
DOE_GRAPHQL_ENDPOINT=https://prod-cms.doe.gov.ph/o/graphql
DOE_GRAPHQL_SITE_KEY=guest
DOE_GRAPHQL_PAGE_SIZE=100

# How far back a normal run looks. The library is newest-first, so this is what
# keeps a daily run to one page instead of walking 14,898 documents.
DOE_LOOKBACK_DAYS=14
# Ceiling, so a misconfigured lookback cannot walk the archive.
DOE_GRAPHQL_MAX_PAGES=3
DOE_BACKFILL_MAX_PAGES=150

# --- schedule ---------------------------------------------------------------
DOE_SCHEDULE_HOUR=6
DOE_SCHEDULE_MINUTE=0
DOE_TIMEZONE=Asia/Manila

# --- extraction -------------------------------------------------------------
# Below this score an extraction is rejected and the next extractor tried. If
# every one falls short the report fails rather than importing a table that
# mostly did not parse.
DOE_MIN_EXTRACTION_QUALITY=0.55
# tabula needs a JVM. Set false where there is none, so the last fallback is
# skipped rather than crashing the run.
DOE_ENABLE_TABULA=true

# --- validation -------------------------------------------------------------
# Pesos per litre. Deliberately wide: the job is to catch a column of volumes
# or a misread decimal, not to second-guess the department.
DOE_MIN_PLAUSIBLE_PRICE=10
DOE_MAX_PLAUSIBLE_PRICE=400

# --- run behaviour ----------------------------------------------------------
DOE_MAX_ATTEMPTS=3
DOE_REQUEST_DELAY_S=1.0

# --- notification -----------------------------------------------------------
# Posted to when a run imports a report or fails. Empty disables it; the run
# log is written either way.
DOE_NOTIFY_WEBHOOK_URL=

# --- observability ----------------------------------------------------------
DOE_LOG_LEVEL=INFO
DOE_LOG_JSON=false
# 0 keeps every PDF. They are the only way to re-extract a past week and are
# ~130KB each; the DOE keeps no accessible archive of superseded publications.
DOE_PDF_RETENTION_DAYS=0
