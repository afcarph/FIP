# Copy to .env and fill in. Every value is read with the DOE_ prefix.
#
#   cp .env.example .env
#
# .env is git-ignored. Nothing here should ever be committed with real values.

# --- dashboard --------------------------------------------------------------
# The full Looker Studio report URL. The DOE republishes under a new report id
# when the dashboard is rebuilt, so this is configuration rather than a
# constant. Open the published dashboard and copy the address bar.
DOE_DASHBOARD_URL=https://lookerstudio.google.com/embed/reporting/REPORT_ID/page/PAGE_ID

# --- database ---------------------------------------------------------------
# Its own database, not the platform's — FIP's Laravel migrations already own a
# `fuel_price_history` with an incompatible shape.
DOE_DB_HOST=127.0.0.1
DOE_DB_PORT=3307
DOE_DB_NAME=fip_doe
DOE_DB_USER=fip
DOE_DB_PASSWORD=
# Only used by docker-compose to initialise the MySQL container.
DOE_DB_ROOT_PASSWORD=

# --- schedule ---------------------------------------------------------------
DOE_SCHEDULE_HOUR=6
DOE_SCHEDULE_MINUTE=0
DOE_TIMEZONE=Asia/Manila

# --- run behaviour ----------------------------------------------------------
DOE_MAX_ATTEMPTS=3
DOE_RETRY_BASE_DELAY_S=5
DOE_HEADLESS=true
# How long to keep listening after the page settles. Looker renders tiles
# lazily and the last data request lands well after load completes.
DOE_SETTLE_TIMEOUT_MS=20000
DOE_BROWSER_TIMEOUT_MS=90000

# --- observability ----------------------------------------------------------
DOE_LOG_LEVEL=INFO
# true emits one JSON object per line, for a log aggregator.
DOE_LOG_JSON=false
# Raw payloads are kept so a run that parses to zero rows can be replayed
# without waiting for tomorrow. Turn off only if disk is tight.
DOE_CAPTURE_PAYLOADS=true
DOE_CAPTURE_RETENTION_DAYS=14
