# ==========================================================================
# Fuel Intelligence Platform — root environment file
# Consumed by docker compose and propagated into each container.
# Copy to `.env` and replace every CHANGE_ME value before deploying.
# ==========================================================================

COMPOSE_PROJECT_NAME=fip
APP_ENV=local
APP_TIMEZONE=Asia/Manila

# ----------------------------- Database -----------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fip
DB_USERNAME=fip
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Staging replica — only read by infra/docker-compose.staging.yml, which adds a
# real replica so the soak measures replication rather than two unrelated
# servers. DB_READ_HOST is set by that overlay, not here: pointing it at a host
# that does not exist breaks every read, which is how CI broke once already.
DB_REPL_USER=repl
DB_REPL_PASSWORD=CHANGE_ME_REPL_PASSWORD
# Buffer pool per database. Two run side by side under the staging overlay, so
# this is halved from the base stack's 512M.
DB_BUFFER_POOL=256M

# ------------------------------ Redis -------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ------------------------------ Backend -----------------------------------
APP_KEY=
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# --------------------------- Object storage --------------------------------
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=fip-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ----------------------------- AI service ----------------------------------
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TOKEN=CHANGE_ME_SHARED_SERVICE_TOKEN
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o-mini
TESSERACT_CMD=/usr/bin/tesseract

# ------------------------- Third-party providers ---------------------------
GOOGLE_MAPS_API_KEY=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
APPLE_CLIENT_ID=CHANGE_ME
APPLE_CLIENT_SECRET=CHANGE_ME
FCM_SERVER_KEY=CHANGE_ME
FCM_PROJECT_ID=CHANGE_ME
EXCHANGE_RATE_API_KEY=CHANGE_ME
DOE_FEED_URL=https://www.doe.gov.ph/retail-pump-prices

# --------------------------- Location tracking -----------------------------
# This file becomes /var/www/html/.env inside the api and scheduler containers,
# so it is where a deployment actually decides retention. Left unset, the
# application falls back to the provisional 30-day default in config/fip.php —
# which is a placeholder, not an approved policy.
#
# ⚠️ Set this deliberately before location tracking runs on real drivers.
# See docs/12-privacy-impact-assessment.md §12.5. Remaining location settings
# are documented in backend/.env.example.
FIP_LOCATION_RETENTION_DAYS=30

# ------------------------------ Mail ---------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@fip.ph
MAIL_FROM_NAME="Fuel Intelligence Platform"

# ----------------------------- Frontend ------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=CHANGE_ME
NEXT_PUBLIC_APP_NAME="Fuel Intelligence Platform"
