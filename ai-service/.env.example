# --- Service ---------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
SERVICE_TOKEN=CHANGE_ME_SHARED_SERVICE_TOKEN
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=45
OPENAI_MAX_TOKENS=800

# --- OCR -------------------------------------------------------------------
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGES=eng
OCR_MIN_CONFIDENCE=0.60

# --- Model artefacts -------------------------------------------------------
MODEL_DIR=/app/models
FORECAST_MODEL_VERSION=1.4.0

# --- Redis (feature + response cache) --------------------------------------
REDIS_URL=redis://redis:6379/2
CACHE_TTL=3600

# --- Optional: read-only database access for training ----------------------
DATABASE_URL=mysql+pymysql://fip:password@mysql:3306/fip
